# Railway: referencia al servicio PostgreSQL, sin credenciales en el repositorio.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/payadmin
# URL pública exacta para validar el origen de las operaciones.
APP_URL=http://localhost:3000
# En Railway debe ser true (HTTPS). false solo para desarrollo HTTP local.
COOKIE_SECURE=false
# disable SOLO para PostgreSQL local/privado sin TLS; verify para TLS con CA válida.
DATABASE_SSL=disable
# Opcional: ruta al certificado CA de PostgreSQL cuando DATABASE_SSL=verify.
# DATABASE_CA_FILE=/ruta/ca.pem
# Inicialización de usuario: proporcionar únicamente al ejecutar user:create.
# ADMIN_EMAIL=tu-correo
# ADMIN_PASSWORD=contraseña-segura-de-al-menos-14-caracteres
# Alternativa sin terminal: código temporal de 32 a 256 caracteres para /registro.
# INITIAL_SETUP_TOKEN=elige-un-codigo-privado-largo-y-aleatorio
# Eliminar INITIAL_SETUP_TOKEN después de crear la primera cuenta desde la web.
