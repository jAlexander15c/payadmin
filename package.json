{
  "name": "payadmin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "user:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-user.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "format": "prettier --write src scripts tests README.md next.config.ts package.json tsconfig.json railway.json public/sw.js public/manifest.webmanifest",
    "format:check": "prettier --check src scripts tests README.md next.config.ts package.json tsconfig.json railway.json public/sw.js public/manifest.webmanifest"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.7",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
